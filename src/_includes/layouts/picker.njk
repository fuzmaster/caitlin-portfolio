<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#fff8e9" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="{{ 'css/style-picker.css' | assetUrl }}" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <header class="picker-header">
    <a class="picker-logo" href="/style-picker/">Caitlin's style studio<span aria-hidden="true">✳</span></a>
    <span class="picker-header__note">A quick visual taste test</span>
  </header>
  <main id="main">{{ content | safe }}</main>
  <script type="module" src="{{ 'js/style-picker.js' | assetUrl }}"></script>
</body>
</html>
