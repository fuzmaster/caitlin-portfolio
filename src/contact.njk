---
layout: layouts/base.njk
title: Contact | Caitlin Britten
description: Contact Caitlin Britten about remote administrative support, scheduling coordination, customer support, and service-team operations roles.
canonicalPath: /contact/
ogType: website
structuredData:
  '@context': https://schema.org
  '@type': ContactPage
  name: Contact Caitlin Britten
---
<section class="section" aria-labelledby="contact-heading">
  <div class="l-shell split-layout split-layout--contact">
    <div>
      <p class="kicker">Contact</p>
      <h1 id="contact-heading">Contact Caitlin about remote admin support</h1>
      <p class="lede">Reach out about remote administrative, scheduling, customer support, or operations assistant opportunities.</p>
      <ul class="contact-list" role="list">
        <li><strong>Email:</strong> <a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        <li><strong>Phone:</strong> <a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></li>
        <li><strong>LinkedIn:</strong> <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">View profile</a></li>
        <li><strong>Setup:</strong> Dedicated home office and high-speed internet</li>
      </ul>
    </div>

    <form class="contact-form" action="https://formspree.io/f/mjgaeykk" method="POST" aria-label="Contact form">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden />
      <input type="hidden" name="_subject" value="New portfolio inquiry from caitlinbritten.com" />
      <div class="field-group">
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field-group">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field-group">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" autocomplete="organization" />
      </div>
      <div class="field-group">
        <label for="opportunity">Opportunity type</label>
        <input id="opportunity" name="opportunity" type="text" placeholder="Remote admin, scheduling coordinator, customer support..." />
      </div>
      <div class="field-group">
        <label for="message">Opportunity details</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>
      <p class="privacy-note">Privacy notice: {{ site.footerPrivacy }}</p>
      <button class="btn btn--primary" type="submit">Send message</button>
    </form>
  </div>
</section>
