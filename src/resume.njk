---
layout: layouts/base.njk
title: Resume | Caitlin Britten
description: Resume for Caitlin Britten, a remote administrative and customer support specialist with scheduling, client communication, payment processing, and campaign support experience.
canonicalPath: /resume/
ogType: profile
structuredData:
  '@context': https://schema.org
  '@type': Person
  name: Caitlin Britten
  jobTitle: Remote Administrative and Customer Support Specialist
  email: mailto:cbrittenb@gmail.com
  telephone: '+19789796500'
  description: Remote administrative and customer support specialist with scheduling, client communication, payment processing, and campaign support experience.
  image: https://caitlinbritten.com/assets/images/avatar.png
  sameAs:
    - https://www.linkedin.com/in/caitlin-britten/
  address:
    '@type': PostalAddress
    addressLocality: Peabody
    addressRegion: MA
  knowsAbout:
    - Scheduling coordination
    - Customer support
    - Calendar management
    - Mindbody
    - Constant Contact
    - Canva
    - Payment processing
---
<section class="section resume-hero" aria-labelledby="resume-heading">
  <div class="l-shell">
    <p class="kicker">Resume</p>
    <h1 id="resume-heading">{{ resume.name }}</h1>
    <p class="lede">{{ resume.summary }}</p>
    <div class="hero__actions hero__actions--left">
      <a class="btn btn--primary" href="/contact/">Contact Caitlin</a>
      <a class="btn btn--ghost" href="/assets/Caitlin_Britten_Resume.docx" download>Download Caitlin Britten's resume DOCX</a>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="resume-proof-heading">
  <div class="l-shell">
    <h2 id="resume-proof-heading">Hiring Snapshot</h2>
    <ul class="metric-list" role="list">
      {% for item in resume.snapshot %}
      <li><strong>{{ item.value }}</strong><span>{{ item.label }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="competencies-heading">
  <div class="l-shell resume-grid">
    <div>
      <p class="kicker">Core Competencies</p>
      <h2 id="competencies-heading">Administrative and support skills</h2>
      <ul class="skill-list" role="list">
        {% for item in resume.competencies %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
    <div>
      <p class="kicker">Software</p>
      <h2>Tools</h2>
      <ul class="skill-list" role="list">
        {% for item in resume.tools %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="experience-heading">
  <div class="l-shell">
    <p class="kicker">Experience</p>
    <h2 id="experience-heading">Professional experience</h2>
    <div class="timeline">
      {% for job in resume.experience %}
      <article class="timeline-item">
        <p class="timeline-item__eyebrow">{{ job.date }}</p>
        <h3>{{ job.role }}</h3>
        <p class="timeline-item__meta">{{ job.company }}, {{ job.location }}</p>
        <ul>
          {% for bullet in job.bullets %}
          <li>{{ bullet }}</li>
          {% endfor %}
        </ul>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="education-heading">
  <div class="l-shell resume-grid">
    <div>
      <p class="kicker">Education</p>
      <h2 id="education-heading">{{ resume.education.school }}</h2>
      <p>{{ resume.education.degree }}</p>
    </div>
    <div>
      <p class="kicker">Certifications</p>
      <h2>Licenses and training</h2>
      <ul class="plain-list" role="list">
        {% for item in resume.certifications %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
